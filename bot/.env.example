# =============================================================================
# Скопируйте этот файл в .env и заполните значения. .env в git не попадает.
# =============================================================================

# ----------------------------- VK -------------------------------------------
# Ключ доступа СООБЩЕСТВА: Управление -> Работа с API -> Ключи доступа.
# Права: "Сообщения сообщества" (и "Управление сообществом" для удобства).
# ВАЖНО: это не токен пользователя и не токен приложения.
VK_TOKEN=

# Числовой id сообщества БЕЗ минуса (например, 123456789).
VK_GROUP_ID=

# Версия VK API. 5.199 актуальна на момент написания.
VK_API_VERSION=5.199

# --------------------------- GigaChat ---------------------------------------
# Authorization key из личного кабинета GigaChat API (Studio/Sber).
# Это строка вида "base64..." — НЕ логин и НЕ пароль.
GIGACHAT_CREDENTIALS=

# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B — юрлица (зависит от тарифа).
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель из списка, доступного вашему ключу (GET /v1/models):
# GigaChat-2 | GigaChat-2-Pro | GigaChat-3-Lightning | ...
# Устаревшие GigaChat/GigaChat-Pro/GigaChat-Max API не принимает (404).
GIGACHAT_MODEL=GigaChat-2

# Таймаут одного запроса к GigaChat, секунд.
GIGACHAT_TIMEOUT=30

# Проверка SSL-сертификатов. false — используется корневой сертификат НУЦ Минцифры,
# который не входит в стандартное хранилище macOS. Для продакшена лучше
# установить сертификат и выставить true (см. README).
GIGACHAT_VERIFY_SSL=false

# ------------------------- База знаний --------------------------------------
# Единая БЗ: .md/.txt/.csv. Вложенные папки = иерархия тем.
# Пример: ./knowledge_base/Услуги/чат-боты.md -> тема "Услуги".
DATA_DIR=./knowledge_base

# ------------------- Яндекс Таблицы (НЕОБЯЗАТЕЛЬНО) ------------------------
# Вариант «только локально» (выбран): оставьте ВСЕ переменные ниже пустыми.
# Бот полностью работает без Яндекса: заявки пишутся в локальный бэкап,
# уведомление приходит в VK. Код интеграции при этом не вызывается.
# Заполняйте блок, только если позже захотите дублировать заявки в таблицу.
YANDEX_TABLES_TOKEN=

# id таблицы (из URL) и имя листа. Нужны только вместе с токеном.
YANDEX_TABLES_ID=
YANDEX_TABLES_SHEET=Leads

# Шаблон endpoint для добавления строк. Трогать не нужно — используется
# только при заполненных YANDEX_TABLES_TOKEN и YANDEX_TABLES_ID.
YANDEX_TABLES_API_URL=https://api.sheets.yandex.net/v1/spreadsheets/{spreadsheet_id}/values/{sheet}:append

# ------------------- Где хранятся данные клиентов ---------------------------
# ВСЕ пути ниже считаются от папки bot/ (если не указан абсолютный путь).
# Абсолютный путь начинается с / или ~/ и используется как есть.
#
# 1) Заявки (имя профиля, контакт, профиль, согласие) — локальный JSONL-файл:
#      <путь_до_проекта>/bot/var/leads_backup.jsonl
#    Формат: JSONL, по одной заявке в строке. Права 0600 (только владелец).
#    Файл создаётся автоматически при первой заявке, в git не попадает.
LEADS_BACKUP_PATH=./var/leads_backup.jsonl

# 2) Логи (ПД маскируются, но всё равно считаются чувствительными):
#      <путь_до_проекта>/bot/logs/bot.log (ротация 5 МБ x 3)
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# 3) Секреты (токены VK/GigaChat) — только в bot/.env, не в git.

# ------------------------- Прочее -------------------------------------------
# Ваш личный VK id для уведомлений о заявках (только маски ПД).
# ВАЖНО для варианта «только локально»: если пусто, уведомлений не будет вообще,
# и единственным местом с заявками останется файл var/leads_backup.jsonl.
# Узнать id: vk.com/im?sel=<своя страница> или через vk.com/dev.
ADMIN_VK_ID=

# Не чаще одного содержательного запроса от пользователя за N секунд.
RATE_LIMIT_SECONDS=60

# Через сколько секунд неактивности чистить контекст диалога и сессию заявки.
CONTEXT_TTL_SECONDS=900

# Сколько последних сообщений хранить в контексте демо-бота.
HISTORY_MESSAGES=5

# Максимум одновременных обработчиков входящих сообщений.
MAX_CONCURRENT_TASKS=20
